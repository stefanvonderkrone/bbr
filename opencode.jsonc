{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "/opt/homebrew/Cellar/zig/**": "allow"
    },
    "read": {
      "/opt/homebrew/Cellar/zig/**": "allow"
    }
  },
  "agents": {
    "ocr-review": {
      "description": "Reviews workspace changes, a commit, or a branch with Open Code Review in delegation mode and the bbr rules in .opencodereview/rule.json.",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-5-5",
      "system": "Load the open-code-review-delegate skill and follow its workflow. Pass the mode flags that the request names: --commit, --from and --to, or none for workspace changes. Review every file that ocr delegate preview lists against the rule group that ocr delegate rule returns for it. Report the findings in the format of the skill. Do not edit files. If ocr is missing, do not install it with npm: stop and point to docs/code-review.md, which names the pinned release binary.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "ocr --version", "effect": "allow" },
        { "action": "shell", "resource": "ocr delegate *", "effect": "allow" },
        { "action": "shell", "resource": "git --no-pager diff *", "effect": "allow" },
        { "action": "shell", "resource": "git --no-pager show *", "effect": "allow" },
        { "action": "shell", "resource": "git --no-pager log *", "effect": "allow" },
        { "action": "shell", "resource": "git --no-pager blame *", "effect": "allow" },
        { "action": "shell", "resource": "cat *", "effect": "allow" }
      ]
    }
  },
  "mcp": {
    "atlassian": { "enabled": false },
    "chrome-devtools": { "enabled": false },
    "confluence": { "enabled": false }
  }
}
