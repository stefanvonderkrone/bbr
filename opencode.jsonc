{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "/opt/homebrew/Cellar/zig/**": "allow"
    },
    "read": {
      "/opt/homebrew/Cellar/zig/**": "allow"
    },
    "bash": {
      "bbr": "deny",
      "bbr *": "deny",
      "zig build run": "deny",
      "zig build run *": "deny",
      "zig-out/bin/bbr": "deny",
      "zig-out/bin/bbr *": "deny",
      "./zig-out/bin/bbr": "deny",
      "./zig-out/bin/bbr *": "deny",
      "/*/bin/bbr": "deny",
      "/*/bin/bbr *": "deny"
    }
  },
  "mcp": {
    "atlassian": { "enabled": false },
    "chrome-devtools": { "enabled": false },
    "confluence": { "enabled": false }
  }
}
