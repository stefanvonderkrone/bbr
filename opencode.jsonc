{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "/opt/homebrew/Cellar/zig/**": "allow"
    },
    "read": {
      "/opt/homebrew/Cellar/zig/**": "allow"
    },
    "bash": {
      "bbr": "deny",
      "bbr *": "deny",
      "*/bbr": "deny",
      "*/bbr *": "deny",
      "*=* bbr": "deny",
      "*=* bbr *": "deny",
      "timeout * bbr": "deny",
      "timeout * bbr *": "deny",
      "*sh -c *bbr*": "deny",
      "*bbr-file-acquisition-bench*": "deny",
      "*zig build run": "deny",
      "*zig build run *": "deny",
      "*zig build * run": "deny",
      "*zig build * run *": "deny",
      "*zig build *check*": "deny",
      "*zig build *bench-file-acquisition*": "deny",
      "*zig run *": "deny",
      "python3 tests/*_test.py zig-out/bin/bbr": "allow"
    }
  },
  "mcp": {
    "atlassian": { "enabled": false },
    "chrome-devtools": { "enabled": false },
    "confluence": { "enabled": false }
  }
}
